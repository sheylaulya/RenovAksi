  npcName: Pak Harjo
  npcTitleName: Si Kepala Desa
  npcPotrait: {fileID: 3465286685962602723, guid: 19d86b447cb98b94da7e1ce96e6e6689, type: 3}
  dialogueLines:
  - Oh, kamu mahasiswa KKN yang tadi dikabarin itu ya?
  - Selamat datang di desa kami. Maaf kalau jalannya tadi agak susah dilalui
  - Kalau mau bantu warga disini, jangan langsung kerja dulu
  - Kenal dulu sama orang-orang di sini. Dengar cerita mereka.
  - Coba ngobrol sama dua warga dulu. Biar kamu tahu desa ini dari sudut pandang
    mereka
  - Kalau sudah, nanti kita lanjut ngobrol
  - yasudah kalo gitu, datangi saya lagi kalo kamu sudah siap
  autoProgressLines: 01010001000000
  endDialogueLines: 00000000000101
  autoProgressDelay: 1.5
  typingSpeed: 0.05
  choices:
  - dialogueIndex: 0
    choices:
    - Betul pak, perkenalkan saya Rizal
    nextDialogueIndexes: 01000000
    choiceTypes: 00000000
  - dialogueIndex: 2
    choices:
    - Maksudnya Pak?
    nextDialogueIndexes: 03000000
    choiceTypes: 00000000
  - dialogueIndex: 4
    choices:
    - Baik Pak, saya coba keliling dulu.
    - Mungkin lain kali pak, saya agak malu..
